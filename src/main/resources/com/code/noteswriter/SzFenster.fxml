<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.noteswriter.Controller"
            style="-fx-background-color: #EEF3F8;">
    <HBox spacing="16.0" AnchorPane.topAnchor="16.0" AnchorPane.leftAnchor="16.0"
          AnchorPane.rightAnchor="16.0" AnchorPane.bottomAnchor="16.0">

        <!-- Linker Bereich: DIN-A4-Seite + Grids -->
        <StackPane fx:id="printArea" minWidth="0.0" minHeight="0.0" HBox.hgrow="ALWAYS">
            <!--
                Die Seite hat ein festes Koordinatensystem. Seite und Noten werden
                gemeinsam über pageContent skaliert, damit ihre Positionen immer
                zueinander passen.
            -->
            <Group fx:id="pageContent">
                <StackPane fx:id="pageCanvas"
                           minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                           minHeight="910.0" prefHeight="910.0" maxHeight="910.0"
                           style="-fx-background-color: white; -fx-border-color: #D7E1EC; -fx-border-width: 1px; -fx-border-radius: 12px; -fx-background-radius: 12px;">
                    <Pane minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                          minHeight="910.0" prefHeight="910.0" maxHeight="910.0">
                        <!-- Die Kreise gehören zur Seite und nicht zu einem skalierten Hintergrundbild. -->
                        <Circle centerX="76.0" centerY="64.0" radius="40.0"
                                fill="WHITE" stroke="BLACK" strokeWidth="4.0" />
                        <Circle centerX="722.0" centerY="64.0" radius="40.0"
                                fill="WHITE" stroke="BLACK" strokeWidth="4.0" />
                        <TextField fx:id="leftCircleText" layoutX="40.0" layoutY="38.0"
                                   prefWidth="72.0" prefHeight="52.0" alignment="CENTER"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <TextField fx:id="rightCircleText" layoutX="686.0" layoutY="38.0"
                                   prefWidth="72.0" prefHeight="52.0" alignment="CENTER"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <TextField fx:id="leftMarchText" layoutX="130.0" layoutY="43.0"
                                   prefWidth="500.0" prefHeight="36.0"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 22px; -fx-font-weight: bold;" />
                        <TextField fx:id="rightMarchText" layoutX="776.0" layoutY="43.0"
                                   prefWidth="490.0" prefHeight="36.0"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 22px; -fx-font-weight: bold;" />
                        <GridPane fx:id="Gridpane1" layoutX="24.0" layoutY="110.0" vgap="3"/>
                        <GridPane fx:id="Gridpane2" layoutX="655.0" layoutY="110.0" vgap="3"/>
                        <Pane fx:id="emptyBlockOverlay" mouseTransparent="true"
                              minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                              minHeight="910.0" prefHeight="910.0" maxHeight="910.0" />
                        <Pane fx:id="pauseOverlay" pickOnBounds="false"
                              minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                              minHeight="910.0" prefHeight="910.0" maxHeight="910.0" />
                        <Pane fx:id="annotationOverlay" pickOnBounds="false"
                              minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                              minHeight="910.0" prefHeight="910.0" maxHeight="910.0" />
                        <Rectangle fx:id="activePageIndicator"
                                   x="10.0" y="10.0" width="630.0" height="890.0"
                                   arcWidth="10.0" arcHeight="10.0"
                                   fill="TRANSPARENT" stroke="#1976D2" strokeWidth="3.0"
                                   mouseTransparent="true" managed="false" visible="false" />
                    </Pane>
                </StackPane>
            </Group>
        </StackPane>

        <!-- Rechter Bereich: übersichtliche Bedienleiste -->
        <ScrollPane fx:id="controlPanel" fitToWidth="true" prefWidth="365.0" minWidth="310.0"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    maxWidth="420.0" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14.0" style="-fx-padding: 18; -fx-background-color: #F8FAFC; -fx-border-color: #DCE6F0; -fx-border-width: 0 0 0 1px;">
                    <VBox spacing="5.0" alignment="CENTER_LEFT">
                            <Label text="SZ Notenschreiber"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #263238;" />
                            <Button fx:id="helpButton" text="Hilfe &amp; Kontakt"
                                    onAction="#handleHelpAction" />
                    </VBox>
                    <HBox spacing="8.0">
                        <Button fx:id="leftPageButton" text="Linke Seite" onAction="#handleSelectLeftPage" />
                        <Button fx:id="rightPageButton" text="Rechte Seite" onAction="#handleSelectRightPage" />
                    </HBox>
                    <HBox spacing="8.0">
                        <Button fx:id="undoButton" text="↶ Rückgängig" onAction="#handleUndoAction" />
                        <Button fx:id="redoButton" text="↷ Wiederherstellen" onAction="#handleRedoAction" />
                    </HBox>
                    <Separator />
                    <Label text="Noten einfügen" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474F;" />
                    <Label text="Linksklick fügt eine Note ein; eine markierte Note wird ersetzt. Ziehen platziert sie auch zwischen vorhandenen Noten. Rechtsklick zeigt Varianten."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                    <TitledPane text="Tastenkürzel &amp; Tonvarianten" expanded="false" animated="false"
                                style="-fx-font-size: 13px; -fx-font-weight: bold;">
                        <content>
                          <VBox spacing="6.0" style="-fx-padding: 8; -fx-background-color: #EEF5FB;">
                        <Label text="Tastenkürzel" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;" />
                        <Label text="Grundtöne:  C · D · E · F · G · A · H"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="B = Ais/B"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Halbtöne:  S = Cis/Des · R = Dis/Es"
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="T = Fis/Ges · Z = Gis/As · V = F_1"
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Hohe Töne:  1–0 = C1 bis A1"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Separator />
                        <Label text="Tonvarianten"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;" />
                        <Label text="Strg + Ton  →  lang"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Alt + Ton  →  kurz"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Umschalt + Ton  →  Oktav"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Strg + Alt + Ton  →  feste"
                               style="-fx-font-size: 12px; -fx-text-fill: #37474F;" />
                        <Label text="Oktav + lang/kurz: Umschalt zusammen mit Strg oder Alt"
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                        <Label text="Backspace / Entf  →  Auswahl löschen; Escape  →  Auswahl aufheben"
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                        <Label text="Strg + Z  →  Rückgängig; Strg + Umschalt + Z  →  Wiederherstellen"
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                          </VBox>
                        </content>
                    </TitledPane>
                    <Label fx:id="keyboardStatus" text="Tastenkürzel gelten außerhalb von Textfeldern. C spielt C1."
                           wrapText="true" minHeight="32.0" style="-fx-font-size: 12px; -fx-text-fill: #1565C0;" />
                    <FlowPane hgap="5.0" vgap="6.0" prefWrapLength="315.0">
                        <Button fx:id="Cis_Des" text="Cis_Des"/>
                        <Button fx:id="D" text="D"/>
                        <Button fx:id="Dis_Es" text="Dis_Es"/>
                        <Button fx:id="E" text="E"/>
                        <Button fx:id="F" text="F"/>
                        <Button fx:id="F_1" text="F_1"/>
                        <Button fx:id="Fis_Ges" text="Fis_Ges"/>
                        <Button fx:id="G" text="G"/>
                        <Button fx:id="Gis_As" text="Gis_As"/>
                        <Button fx:id="A" text="A"/>
                        <Button fx:id="Ais_B" text="Ais_B"/>
                        <Button fx:id="H" text="H"/>
                        <Button fx:id="C1" text="C1"/>
                        <Button fx:id="Cis_Des1" text="Cis_Des1"/>
                        <Button fx:id="D1" text="D1"/>
                        <Button fx:id="Dis_Es1" text="Dis_Es1"/>
                        <Button fx:id="E1" text="E1"/>
                        <Button fx:id="Fis_Ges1" text="Fis_Ges1"/>
                        <Button fx:id="F1" text="F1"/>
                        <Button fx:id="G1" text="G1"/>
                        <Button fx:id="Gis_As1" text="Gis_As1"/>
                        <Button fx:id="A1" text="A1"/>
                    </FlowPane>
                    <Button fx:id="emptyBlockButton" text="Leerer Notenblock"
                            onAction="#handleEmptyBlockAction" />
                    <Label text="Schließt den aktuellen Block ab und lässt eine ganze Zeile frei – auch als letzte Zeile der Seite."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                    <Separator />
                    <HBox spacing="8.0">
                        <Button fx:id="Wiederholungszeichen" text="Wiederholungen"
                                onAction="#handleWiederholungszeichenAction" />
                        <Button fx:id="pauseStrokeButton" text="Pausenstrich"
                                onAction="#handlePauseStrokeAction" />
                    </HBox>
                    <Separator />
                    <Label text="Freien Text eingeben und anschließend auf der Seite verschieben. Rechtsklick ändert die Schriftgröße oder löscht ihn."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                    <TextField fx:id="freeTextInput" promptText="Freien Text eingeben" />
                    <Button fx:id="addFreeTextButton" text="Freitext"
                            onAction="#handleAddFreeTextAction" />
                    <Separator />
                    <VBox spacing="7.0" style="-fx-padding: 10; -fx-background-color: #E6F4EE; -fx-background-radius: 8; -fx-text-base-color: #000000; -fx-text-background-color: #000000; -fx-text-inner-color: #000000;">
                        <Label text="Notenmikrofon" style="-fx-font-weight: bold; -fx-text-fill: #000000;" />
                        <ComboBox fx:id="microphoneDevice" maxWidth="Infinity" style="-fx-text-base-color: #000000; -fx-text-background-color: #000000;" />
                        <ComboBox fx:id="microphoneInstrument" maxWidth="Infinity" style="-fx-text-base-color: #000000; -fx-text-background-color: #000000;" />
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="Kammerton A (Hz)" labelFor="$concertPitch" style="-fx-text-fill: #000000;" />
                            <Spinner fx:id="concertPitch" prefWidth="95.0" editable="false" style="-fx-text-inner-color: #000000;" />
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="Grifflage (Oktaven)" labelFor="$microphoneOctave" style="-fx-text-fill: #000000;" />
                            <Spinner fx:id="microphoneOctave" prefWidth="95.0" editable="false" style="-fx-text-inner-color: #000000;" />
                        </HBox>
                        <Label text="Ces-Vorgabe: −1. D_Oktav ca. 550 Hz, D ca. 1124 Hz, D1 ca. 2207 Hz. Bei Instrumentwechsel wird die Vorgabe neu gesetzt."
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #000000;" />
                        <Label text="Empfindlichkeit: links empfindlicher, rechts weniger" wrapText="true" style="-fx-text-fill: #000000;" />
                        <Slider fx:id="microphoneThreshold" min="-60" max="-20" value="-40" />
                        <Button fx:id="microphoneButton" text="Mikrofon starten" onAction="#handleMicrophoneAction" style="-fx-text-fill: #000000;" />
                        <Label fx:id="microphoneStatus" text="Mikrofon aus. Es werden keine Tondateien gespeichert." wrapText="true" minHeight="40.0" style="-fx-text-fill: #000000;" />
                        <Label text="Einzeltöne kurz halten. Gleicher Ton erneut: dazwischen kurz pausieren. Einfügen auf der aktiven Seite, ohne automatische Notenlängen."
                               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #000000;" />
                    </VBox>
                    <Separator />
                    <Label text="Weitere Aktionen" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474F;" />
                    <Button fx:id="Speichern" text="Speichern" onAction="#handleSaveToFile" />
                    <Button fx:id="Laden" text="Laden" onAction="#handleLoadChoice" />
                    <Button fx:id="printGridPaneButton" onAction="#handlePrintGridPaneAction" text="Drucken / PDF exportieren" />
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</AnchorPane>
