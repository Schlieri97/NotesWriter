<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.noteswriter.Controller">
    <HBox spacing="16.0" AnchorPane.topAnchor="16.0" AnchorPane.leftAnchor="16.0"
          AnchorPane.rightAnchor="16.0" AnchorPane.bottomAnchor="16.0">

        <!-- Linker Bereich: DIN-A4-Seite + Grids -->
        <StackPane fx:id="printArea" minWidth="0.0" minHeight="0.0" HBox.hgrow="ALWAYS">
            <!--
                Die Seite hat ein festes Koordinatensystem. Seite und Noten werden
                gemeinsam über pageContent skaliert, damit ihre Positionen immer
                zueinander passen.
            -->
            <Group fx:id="pageContent">
                <StackPane fx:id="pageCanvas"
                           minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                           minHeight="910.0" prefHeight="910.0" maxHeight="910.0"
                           style="-fx-background-color: white;">
                    <Pane minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                          minHeight="910.0" prefHeight="910.0" maxHeight="910.0">
                        <!-- Die Kreise gehören zur Seite und nicht zu einem skalierten Hintergrundbild. -->
                        <Circle centerX="76.0" centerY="64.0" radius="40.0"
                                fill="WHITE" stroke="BLACK" strokeWidth="4.0" />
                        <Circle centerX="722.0" centerY="64.0" radius="40.0"
                                fill="WHITE" stroke="BLACK" strokeWidth="4.0" />
                        <TextField fx:id="leftCircleText" layoutX="40.0" layoutY="38.0"
                                   prefWidth="72.0" prefHeight="52.0" alignment="CENTER"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <TextField fx:id="rightCircleText" layoutX="686.0" layoutY="38.0"
                                   prefWidth="72.0" prefHeight="52.0" alignment="CENTER"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <TextField fx:id="leftMarchText" layoutX="130.0" layoutY="43.0"
                                   prefWidth="500.0" prefHeight="36.0"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 22px; -fx-font-weight: bold;" />
                        <TextField fx:id="rightMarchText" layoutX="776.0" layoutY="43.0"
                                   prefWidth="490.0" prefHeight="36.0"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 22px; -fx-font-weight: bold;" />
                        <GridPane fx:id="Gridpane1" layoutX="24.0" layoutY="110.0" vgap="3"/>
                        <GridPane fx:id="Gridpane2" layoutX="655.0" layoutY="110.0" vgap="3"/>
                        <Pane fx:id="pauseOverlay" pickOnBounds="false"
                              minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                              minHeight="910.0" prefHeight="910.0" maxHeight="910.0" />
                        <Pane fx:id="annotationOverlay" pickOnBounds="false"
                              minWidth="1290.0" prefWidth="1290.0" maxWidth="1290.0"
                              minHeight="910.0" prefHeight="910.0" maxHeight="910.0" />
                    </Pane>
                </StackPane>
            </Group>
        </StackPane>

        <!-- Rechter Bereich: übersichtliche Bedienleiste -->
        <ScrollPane fx:id="controlPanel" fitToWidth="true" prefWidth="365.0" minWidth="310.0"
                    maxWidth="420.0" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14.0" style="-fx-padding: 16; -fx-background-color: #F7F8FA;">
                    <VBox spacing="5.0" alignment="CENTER_LEFT">
                            <Label text="SZ Notenschreiber"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #263238;" />
                            <Button fx:id="helpButton" text="Hilfe &amp; Kontakt"
                                    onAction="#handleHelpAction" />
                    </VBox>
                    <Label text="Aktive Notenseite" style="-fx-font-size: 13px; -fx-text-fill: #607D8B;" />
                    <Label fx:id="pageIndicator" text="Linke Seite"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 8 12;" />
                    <HBox spacing="8.0">
                        <Button fx:id="leftPageButton" text="Linke Seite" onAction="#handleSelectLeftPage" />
                        <Button fx:id="rightPageButton" text="Rechte Seite" onAction="#handleSelectRightPage" />
                    </HBox>
                    <Button fx:id="deleteLastNoteButton" onAction="#handleDeleteLastNoteAction"
                            text="Letzte Note löschen" />
                    <Button fx:id="deleteAllNotesButton" onAction="#handleDeleteAllNotesAction"
                            text="Alle Noten der linken Seite löschen"
                            style="-fx-font-weight: bold;" />
                    <Separator />
                    <Label text="Noten einfügen" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474F;" />
                    <Label text="Linksklick fügt die Note auf der aktiven Seite ein. Rechtsklick zeigt Varianten."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                    <FlowPane hgap="5.0" vgap="6.0" prefWrapLength="315.0">
                        <Button fx:id="Cis_Des" text="Cis_Des"/>
                        <Button fx:id="D" text="D"/>
                        <Button fx:id="Dis_Es" text="Dis_Es"/>
                        <Button fx:id="E" text="E"/>
                        <Button fx:id="F" text="F"/>
                        <Button fx:id="F_1" text="F_1"/>
                        <Button fx:id="Fis_Ges" text="Fis_Ges"/>
                        <Button fx:id="G" text="G"/>
                        <Button fx:id="Gis_As" text="Gis_As"/>
                        <Button fx:id="A" text="A"/>
                        <Button fx:id="Ais_B" text="Ais_B"/>
                        <Button fx:id="H" text="H"/>
                        <Button fx:id="C1" text="C1"/>
                        <Button fx:id="Cis_Des1" text="Cis_Des1"/>
                        <Button fx:id="D1" text="D1"/>
                        <Button fx:id="Dis_Es1" text="Dis_Es1"/>
                        <Button fx:id="E1" text="E1"/>
                        <Button fx:id="Fis_Ges1" text="Fis_Ges1"/>
                        <Button fx:id="F1" text="F1"/>
                        <Button fx:id="G1" text="G1"/>
                        <Button fx:id="Gis_As1" text="Gis_As1"/>
                        <Button fx:id="A1" text="A1"/>
                    </FlowPane>
                    <Label fx:id="editSelectionLabel" text="Keine Note ausgewählt"
                           wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold;" />

                    <Separator />
                    <Label text="Wiederholungszeichen, Pausenstrich"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474F;" />
                    <HBox spacing="8.0">
                        <Button fx:id="Wiederholungszeichen" text="Wiederholungszeichen"
                                onAction="#handleWiederholungszeichenAction" />
                        <Button fx:id="pauseStrokeButton" text="Pausenstrich"
                                onAction="#handlePauseStrokeAction" />
                    </HBox>
                    <Label text="Freien Text eingeben und anschließend auf der Seite verschieben. Rechtsklick löscht ihn."
                           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #607D8B;" />
                    <TextField fx:id="freeTextInput" promptText="Freien Text eingeben" />
                    <Button fx:id="addFreeTextButton" text="Text auf Seite einfügen"
                            onAction="#handleAddFreeTextAction" />
                    <Separator />
                    <Label text="Weitere Aktionen" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474F;" />
                    <Button fx:id="Speichern" text="Speichern" onAction="#handleSaveToFile" />
                    <Button fx:id="Laden" text="Laden" onAction="#handleLoadChoice" />
                    <Button fx:id="printGridPaneButton" onAction="#handlePrintGridPaneAction" text="Drucken (A4 quer)" />
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</AnchorPane>
